          "type": "number",
          "required": false,
          "default": 280,
          "description": "Diameter in px. Default 280."
        },
        "showLegend": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": ""
        },
        "formatValue": {
          "type": "((value: number) => string)",
          "required": false,
          "default": "(value: number) =>\n  new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(value)",
          "description": ""
        },
        "className": {
          "type": "string",
          "required": false,
          "default": null,
          "description": ""
        }
      }
    },
    {
      "name": "Sparkline",
      "import": "import { Sparkline } from '@ds/react';",
      "description": "A tiny line chart without axes, to show a trend next to a figure.",
      "props": {
        "data": {
          "type": "number[]",
          "required": true,
          "default": null,
          "description": "The values, oldest first."
        },
        "tone": {
          "type": "1 | \"auto\" | \"primary\" | \"positive\" | \"negative\" | 2 | 3 | 4 | 5 | 6 | 7 | 8",
          "values": [
            "1",
            "auto",
            "primary",
            "positive",
            "negative",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8"
          ],
          "required": false,
          "default": "auto",
          "description": "Line color: `auto` (default) green when the last value is higher than the first and red when\nlower, or a fixed `primary`, `positive`, `negative` or series 1–8."
        },
        "area": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Fills the area under the line. Default true."
        },
        "height": {
          "type": "number",
          "required": false,
          "default": 48,
          "description": "Height in px. Default 48. Width fills the container."
        },
        "label": {
          "type": "string",
          "required": false,
          "default": null,
          "description": "What the sparkline shows, e.g. \"Revenue, last 12 months: rising\". Without it, decorative."
        },
        "className": {
          "type": "string",
          "required": false,
          "default": null,
          "description": ""
        }
      }
    }
  ],
  "tokens": {
