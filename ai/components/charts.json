      "description": "Data series colors 1–8, in the order charts assign them; 1 is the brand.",
      "references": "--color-chart-1",
      "default": "#794dff",
      "byTheme": {
        "brand=diamond,mode=dark": "#f2edff",
        "brand=amber,mode=light": "#8a663e",
        "brand=amber,mode=dark": "#fff",
        "brand=opal,mode=light": "#2a5caf",
        "brand=opal,mode=dark": "#fff"
      }
    },
    "--chart-series-2-color": {
      "description": "Data series colors 1–8, in the order charts assign them; 1 is the brand.",
      "references": "--color-chart-2",
