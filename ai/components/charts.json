    {
      "name": "BarChart",
      "import": "import { BarChart } from '@ds/react';",
      "description": "Compares values across categories, side by side or stacked.",
      "props": {
        "stacked": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Stacks series in one bar instead of side by side."
        },
        "orientation": {
          "type": "\"vertical\" | \"horizontal\"",
          "values": [
            "vertical",
            "horizontal"
          ],
          "required": false,
          "default": "vertical",
          "description": "`vertical` (default) columns, `horizontal` bars, e.g. for long category names."
        },
        "title": {
          "type": "string",
          "required": true,
          "default": null,
          "description": "Names the chart; shown above it unless hideTitle. Also names its data table."
        },
        "hideTitle": {
          "type": "boolean",
          "required": false,
          "default": null,
          "description": "Hides the title visually; it still names the chart for screen readers."
        },
        "description": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "One sentence on what the chart shows."
        },
        "data": {
          "type": "ChartRow[]",
          "required": true,
          "default": null,
          "description": "One object per point on the x axis, e.g. `{ month: 'Jan', revenue: 12000 }`."
        },
        "xKey": {
          "type": "string",
          "required": true,
