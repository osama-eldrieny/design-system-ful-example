        },
        "series": {
          "type": "ChartSeries[]",
          "required": true,
          "default": null,
          "description": "The series to draw."
        },
        "height": {
          "type": "number",
          "required": false,
          "default": 48,
          "description": "Plot height in px. Default 240."
        },
        "formatValue": {
          "type": "((value: number) => string)",
          "required": false,
          "default": "(value: number) =>\n  new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(value)",
          "description": "Formats values on the axis and in the tooltip. Default compact numbers (12K)."
        },
        "showLegend": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Shows the legend under the chart. Default: when there are several series."
        },
        "showGrid": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Shows horizontal gridlines. Default true."
        },
        "hideYAxis": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Hides the value axis labels, e.g. in small cards."
        },
        "className": {
          "type": "string",
          "required": false,
          "default": null,
          "description": ""
        }
      }
    },
    {
      "name": "DonutChart",
      "import": "import { DonutChart } from '@ds/react';",
      "description": "Parts of a whole: a ring (or pie) of up to about six slices.",
      "props": {
        "title": {
          "type": "string",
          "required": true,
          "default": null,
          "description": ""
        },
        "hideTitle": {
          "type": "boolean",
          "required": false,
          "default": null,
          "description": ""
        },
        "description": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": ""
        },
        "data": {
          "type": "{ label: string; value: number; color?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | undefined; }[]",
          "required": true,
          "default": null,
          "description": "One slice per item."
        },
        "size": {
          "type": "number",
          "required": false,
          "default": 280,
          "description": "Diameter in px. Default 200."
        },
        "thickness": {
          "type": "number",
          "required": false,
          "default": 0.28,
          "description": "Ring thickness as a share of the radius, 0–1. 1 draws a pie. Default 0.28."
        },
        "centerValue": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "Big figure in the middle, e.g. the total."
        },
        "centerLabel": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "Caption under the center figure, e.g. \"Total visits\"."
        },
        "formatValue": {
          "type": "((value: number) => string)",
          "required": false,
          "default": "(value: number) =>\n  new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(value)",
          "description": ""
        },
        "showLegend": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Default true."
        },
        "className": {
          "type": "string",
          "required": false,
          "default": null,
          "description": ""
        }
      }
    },
    {
      "name": "RadarChart",
      "import": "import { RadarChart } from '@ds/react';",
      "description": "Compares a few series across several dimensions, e.g. skills or product scores.",
      "props": {
        "title": {
          "type": "string",
          "required": true,
          "default": null,
          "description": ""
        },
        "hideTitle": {
          "type": "boolean",
          "required": false,
          "default": null,
          "description": ""
        },
        "description": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": ""
        },
        "data": {
          "type": "ChartRow[]",
          "required": true,
          "default": null,
          "description": "One object per axis, e.g. `{ skill: 'Design', alice: 8, bob: 5 }`."
        },
        "axisKey": {
          "type": "string",
          "required": true,
          "default": null,
          "description": "Field holding each axis name."
        },
        "series": {
          "type": "ChartSeries[]",
          "required": true,
          "default": null,
          "description": ""
        },
        "max": {
          "type": "number",
