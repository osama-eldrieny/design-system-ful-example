{
  "id": "progress",
  "name": "Progress",
  "category": "Feedback",
  "status": "stable",
  "since": "0.4.0",
  "description": "A progress bar shows how far a task has got, such as an upload or setup steps. Without a value it becomes an indeterminate, animated bar.",
  "imports": [
    {
      "name": "Progress",
      "from": "@ds/react"
    },
    {
      "name": "ProgressCircle",
      "from": "@ds/react"
    }
  ],
  "whenToUse": [
    "For tasks with measurable progress: uploads, downloads, processing.",
    "For completion, e.g. a profile 60% complete or storage used."
  ],
  "whenNotToUse": [
    {
      "text": "For unknown, short waits in a small area.",
      "alternative": "Spinner"
    },
    {
      "text": "For steps people move through.",
      "alternative": "Stepper"
    }
  ],
  "anatomy": [
    {
      "name": "Label",
      "description": "Names the bar."
    },
    {
      "name": "Value",
      "description": "“45%”.",
      "optional": true
    },
    {
      "name": "Track",
      "description": "The full length."
    },
    {
      "name": "Bar",
      "description": "The completed part in the tone color."
    }
  ],
  "options": [
    {
      "prop": "tone",
      "title": "Tone",
      "values": [
        {
          "value": "primary",
          "meaning": "Default."
        },
        {
          "value": "success",
          "meaning": "Complete or healthy."
        },
        {
          "value": "warning",
          "meaning": "Near a limit, e.g. storage 90%."
        },
        {
          "value": "danger",
          "meaning": "Over a limit or failed."
        }
      ]
    },
    {
      "prop": "size",
      "title": "Size",
      "values": [
        {
          "value": "medium",
          "meaning": "Default."
        },
        {
          "value": "small",
          "meaning": "Thin; cards and tables."
        }
      ]
    },
    {
      "prop": "valuePosition",
      "title": "Value position",
      "values": [
        {
          "value": "top",
          "meaning": "Beside the label. Default."
        },
        {
          "value": "end",
          "meaning": "After the bar, for compact rows."
        },
        {
          "value": "bottom",
          "meaning": "Under the end of the bar."
        }
      ]
    },
    {
      "prop": "shape",
      "title": "ProgressCircle shape",
      "values": [
        {
          "value": "circle",
          "meaning": "A full ring. Default."
        },
        {
          "value": "half",
          "meaning": "A semicircle gauge, for scores and quotas."
        }
      ]
    }
  ],
  "states": [
    {
      "name": "Determinate",
      "meaning": "Bar length shows value/max.",
      "trigger": "value"
    },
    {
      "name": "Indeterminate",
      "meaning": "Animated bar; unknown progress.",
      "trigger": "no value"
    }
  ],
  "behavior": [
    {
      "topic": "Announcement",
      "text": "A progressbar with aria-valuenow and aria-valuetext (“45%”). Screen readers read it when focused or navigated to; announce completion separately."
    },
    {
      "topic": "Motion",
      "text": "The bar eases between values; the indeterminate animation slows for reduced motion."
    }
  ],
  "content": [
    "Label: what is happening, e.g. “Uploading report.pdf”."
  ],
  "guidelines": [
    {
      "do": "Always give a label.",
      "dont": "Show an unlabelled bar.",
      "why": "The label says what is progressing."
    },
    {
      "do": "Announce completion with an Alert or toast.",
      "dont": "Rely on the bar reaching 100%.",
      "why": "Screen reader users don’t hear the bar change."
    },
    {
      "do": "Use a tone with a word for limits (“90% used”).",
      "dont": "Show danger color without saying why.",
      "why": "Color alone isn’t enough."
    }
  ],
  "accessibility": {
    "role": "progressbar.",
    "keyboard": [
      {
        "keys": "—",
        "action": "Not focusable."
      }
    ],
    "aria": [
      {
        "attribute": "aria-labelledby",
        "when": "The label."
      },
      {
        "attribute": "aria-valuenow / min / max / valuetext",
        "when": "Determinate; left out when indeterminate."
      }
    ],
    "focus": "None.",
    "wcag": [
      {
        "criterion": "1.3.1 Info and Relationships",
        "how": "Labelled progressbar."
      },
      {
        "criterion": "1.4.11 Non-text Contrast",
        "how": "Bar meets 3:1 against the track."
      },
      {
        "criterion": "2.3.3 Animation from Interactions",
        "how": "Slows for reduced motion."
      }
    ],
    "notes": []
  },
  "examples": [
    {
      "id": "circle",
      "title": "Ring",
      "description": "ProgressCircle with a caption.",
      "code": "import { ProgressCircle } from '@ds/react';\n\n<ProgressCircle label=\"Storage used\" value={64} caption=\"of 20 GB\" />"
    },
    {
      "id": "gauge",
      "title": "Gauge",
      "description": "A half-ring for scores.",
      "code": "import { ProgressCircle } from '@ds/react';\n\n<ProgressCircle label=\"Health score\" value={72} shape=\"half\" />"
    },
    {
      "id": "upload",
      "title": "Upload",
      "description": "With the value shown.",
      "code": "import { Progress } from '@ds/react';\n\n<Progress label=\"Uploading report.pdf\" value={45} showValue />"
    },
    {
      "id": "storage",
      "title": "Storage",
      "description": "Custom format and tone.",
      "code": "import { Progress } from '@ds/react';\n\n<Progress label=\"Storage\" value={9.1} max={10} tone=\"warning\" showValue formatValue={(v, m) => `${v} of ${m} GB`} />"
    },
    {
      "id": "indeterminate",
      "title": "Indeterminate",
      "description": "Unknown progress.",
      "code": "import { Progress } from '@ds/react';\n\n<Progress label=\"Preparing export\" />"
    }
  ],
  "tokenPrefixes": [
    "--progress-"
  ],
  "related": [
    {
      "id": "spinner",
      "relation": "For unknown waits."
    },
    {
      "id": "stepper",
      "relation": "For multi-step tasks."
    }
  ],
  "changelog": [
    {
      "version": "0.4.0",
      "date": "2026-09-29",
      "changes": [
        "New component."
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-10-15",
      "changes": [
        "valuePosition: top, end or bottom.",
        "New ProgressCircle: a ring or half-ring gauge with the value inside."
      ]
    }
  ],
  "components": [
    {
      "name": "Progress",
      "import": "import { Progress } from '@ds/react';",
      "description": "A bar showing how far a task has got, such as an upload. Indeterminate without a value.",
      "props": {
        "label": {
          "type": "ReactNode",
          "required": true,
          "default": null,
          "description": "What is progressing, e.g. \"Uploading report.pdf\". Names the bar."
        },
        "hideLabel": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Hides the label visually but keeps it for screen readers."
        },
        "value": {
          "type": "number",
          "required": false,
          "default": null,
          "description": "Current value. Leave out for unknown progress (an animated, indeterminate bar)."
        },
        "max": {
          "type": "number",
          "required": false,
          "default": 100,
          "description": "Value when complete. Default 100."
        },
        "showValue": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Shows the value, e.g. \"45%\", next to the label."
        },
        "formatValue": {
          "type": "((value: number, max: number) => string)",
          "required": false,
          "default": "(value: number, max: number) => `${Math.round((value / max) * 100)}%`",
          "description": "Formats the shown and announced value. Default a percentage."
        },
        "tone": {
          "type": "\"primary\" | \"success\" | \"warning\" | \"danger\"",
          "values": [
            "primary",
            "success",
            "warning",
            "danger"
          ],
          "required": false,
          "default": "primary",
          "description": "Color meaning: primary (default), success, warning, danger."
        },
        "size": {
          "type": "\"small\" | \"medium\"",
          "values": [
            "small",
            "medium"
          ],
          "required": false,
          "default": "medium",
          "description": "`small` for a thin bar in cards and tables, `medium` by default."
        },
        "valuePosition": {
          "type": "\"top\" | \"end\" | \"bottom\"",
          "values": [
            "top",
            "end",
            "bottom"
          ],
          "required": false,
          "default": "top",
          "description": "Where the value shows with showValue: `top` (default) beside the label, `end` after the\nbar, `bottom` under the bar's end."
        }
      }
    },
    {
      "name": "ProgressCircle",
      "import": "import { ProgressCircle } from '@ds/react';",
      "description": "A ring or half-ring gauge showing how far along something is, with the value inside.",
      "props": {
        "label": {
          "type": "ReactNode",
          "required": true,
          "default": null,
          "description": "What is measured, e.g. \"Storage used\". Names the progress bar; shown under the ring."
        },
        "hideLabel": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Hides the label visually; it is still announced."
        },
        "value": {
          "type": "number",
          "required": true,
          "default": null,
          "description": "Current value, 0 to max."
        },
        "max": {
          "type": "number",
          "required": false,
          "default": 100,
          "description": ""
        },
        "formatValue": {
          "type": "((value: number, max: number) => string)",
          "required": false,
          "default": "(value: number, max: number) => `${Math.round((value / max) * 100)}%`",
          "description": "Text in the middle. Default: the percentage."
        },
        "caption": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "Small caption under the value inside the ring, e.g. \"Active users\"."
        },
        "shape": {
          "type": "\"circle\" | \"half\"",
          "values": [
            "circle",
            "half"
          ],
          "required": false,
          "default": "circle",
          "description": "`circle` (default) full ring, `half` a semicircle gauge."
        },
        "size": {
          "type": "\"small\" | \"medium\" | \"large\"",
          "values": [
            "small",
            "medium",
            "large"
          ],
          "required": false,
          "default": "medium",
          "description": "`small` 64px, `medium` 120px (default), `large` 200px."
        },
        "tone": {
          "type": "\"primary\" | \"success\" | \"warning\" | \"danger\"",
          "values": [
            "primary",
            "success",
            "warning",
            "danger"
          ],
          "required": false,
          "default": "primary",
          "description": ""
        }
      }
    }
  ],
