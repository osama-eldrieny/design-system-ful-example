{
  "id": "stat",
  "name": "Stat",
  "category": "Data display",
  "status": "stable",
  "since": "0.4.0",
  "description": "A stat shows one key figure with its label and change, such as revenue up 12.5% vs last month. Trends are shown with an arrow, a color and words for screen readers.",
  "imports": [
    {
      "name": "Stat",
      "from": "@ds/react"
    }
  ],
  "whenToUse": [
    "For KPI tiles and dashboard summaries."
  ],
  "whenNotToUse": [
    {
      "text": "For tables of figures.",
      "alternative": "Table"
    },
    {
      "text": "For progress toward a goal.",
      "alternative": "Progress"
    }
  ],
  "anatomy": [
    {
      "name": "Label",
      "description": "What is measured."
    },
    {
      "name": "Value",
      "description": "The figure."
    },
    {
      "name": "Change",
      "description": "Arrow, change and context, as text or a badge.",
      "optional": true
    },
    {
      "name": "Note",
      "description": "A line under the figure, e.g. when it was updated.",
      "optional": true
    }
  ],
  "options": [
    {
      "prop": "trend",
      "title": "Trend",
      "values": [
        {
          "value": "up",
          "meaning": "Arrow up; good by default."
        },
        {
          "value": "down",
          "meaning": "Arrow down; bad by default."
        },
        {
          "value": "neutral",
          "meaning": "No arrow."
        }
      ]
    },
    {
      "prop": "positive",
      "title": "Meaning",
      "values": [
        {
          "value": "true",
          "meaning": "The change is good news (green)."
        },
        {
          "value": "false",
          "meaning": "The change is bad news (red)."
        }
      ]
    },
    {
      "prop": "size",
      "title": "Size",
      "values": [
        {
          "value": "small",
          "meaning": "Dense rows of figures, e.g. under a chart."
        },
        {
          "value": "medium",
          "meaning": "Default."
        },
        {
          "value": "large",
          "meaning": "A headline figure at the top of a card."
        }
      ]
    },
    {
      "prop": "changeAppearance",
      "title": "Change appearance",
      "values": [
        {
          "value": "text",
          "meaning": "Default. Arrow and change under the value, with the context after it."
        },
        {
          "value": "badge",
          "meaning": "A tinted pill beside the value; the context moves under it."
        }
      ]
    }
  ],
  "states": [
    {
      "name": "Static",
      "meaning": "Not interactive.",
      "trigger": "—"
    }
  ],
  "behavior": [
    {
      "topic": "Semantics",
      "text": "A description list: label (dt), value and change (dd)."
    },
    {
      "topic": "Trend words",
      "text": "“increased” or “decreased” is read before the change."
    }
  ],
  "content": [
    "Format values for the reader: currency, thousands separators, units."
  ],
  "guidelines": [
    {
      "do": "Set positive for metrics where down is good.",
      "dont": "Show falling costs in red.",
      "why": "Color should match whether the change is good."
    },
    {
      "do": "Give context (“vs last month”).",
      "dont": "Show “+12%” with no period.",
      "why": "A change means nothing without a baseline."
    },
    {
      "do": "Round figures sensibly.",
      "dont": "Show $124,567.2381.",
      "why": "Precision beyond need slows reading."
    }
  ],
  "accessibility": {
    "role": "description list.",
    "keyboard": [
      {
        "keys": "—",
        "action": "Not focusable."
      }
    ],
    "aria": [
      {
        "attribute": "visually hidden trend word",
        "when": "Up and down changes."
      }
    ],
    "focus": "None.",
    "wcag": [
      {
        "criterion": "1.4.1 Use of Color",
        "how": "Arrow and words, not just color."
      },
      {
        "criterion": "1.3.1 Info and Relationships",
        "how": "Label and value are paired in a dl."
      }
    ],
    "notes": []
  },
  "examples": [
    {
      "id": "basic",
      "title": "KPI",
      "description": "Revenue up.",
      "code": "import { Stat } from '@ds/react';\n\n<Stat label=\"Total revenue\" value=\"$124,567\" change=\"+12.5%\" trend=\"up\" help=\"vs last month\" />"
    },
    {
      "id": "down-good",
      "title": "Down is good",
      "description": "Costs falling.",
      "code": "import { Stat } from '@ds/react';\n\n<Stat label=\"Costs\" value=\"$8,210\" change=\"-4%\" trend=\"down\" positive />"
    },
    {
      "id": "plain",
      "title": "Value only",
      "description": "No change.",
      "code": "import { Stat } from '@ds/react';\n\n<Stat label=\"Active users\" value=\"8,432\" />"
    }
  ],
  "tokenPrefixes": [
    "--stat-"
  ],
  "related": [
    {
      "id": "card",
      "relation": "Put stats in cards for dashboards."
    }
  ],
  "changelog": [
    {
      "version": "1.3.0",
      "date": "2026-10-15",
      "changes": [
        "size, changeAppearance (badge), note."
      ]
    },
    {
      "version": "0.4.0",
      "date": "2026-09-29",
      "changes": [
        "New component."
      ]
    }
  ],
  "components": [
    {
      "name": "Stat",
      "import": "import { Stat } from '@ds/react';",
      "description": "A key figure with its label and change, e.g. for dashboards.",
      "props": {
        "label": {
          "type": "ReactNode",
          "required": true,
          "default": null,
          "description": "What is measured, e.g. \"Total revenue\"."
        },
        "value": {
          "type": "ReactNode",
          "required": true,
          "default": null,
          "description": "The figure, formatted, e.g. \"$124,567\"."
        },
        "change": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "Change since the previous period, e.g. \"+12.5%\"."
        },
        "trend": {
          "type": "\"up\" | \"down\" | \"neutral\"",
          "values": [
            "up",
            "down",
            "neutral"
          ],
          "required": false,
          "default": "neutral",
          "description": "Direction of the change: `up` or `down` (colored and announced), `neutral`. Whether up is\ngood depends on the metric: set `positive` accordingly."
        },
        "positive": {
          "type": "boolean",
          "required": false,
          "default": null,
          "description": "Whether the trend is good news. Default: up is good. Use false for e.g. costs rising."
        },
        "help": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "Context for the change, e.g. \"vs last month\"."
        },
        "size": {
          "type": "StatSize",
          "values": [
            "small",
            "medium",
            "large"
          ],
          "required": false,
          "default": "medium",
          "description": "`small` in dense rows, `medium` (default), `large` for a headline figure."
        },
        "changeAppearance": {
          "type": "StatChangeAppearance",
          "values": [
            "text",
            "badge"
          ],
          "required": false,
          "default": "text",
          "description": "`text` (default) shows the change under the value; `badge` puts it beside the value as a tinted pill."
        },
        "note": {
          "type": "ReactNode",
          "required": false,
          "default": null,
          "description": "A line under the figure, e.g. \"Updated 5 minutes ago\"."
        },
        "trendLabels": {
          "type": "{ up?: string; down?: string; } | undefined",
          "required": false,
          "default": null,
          "description": "Words announced for the trend, for translation."
        }
      }
    }
  ],
