        "brand=diamond,mode=dark": "#332e3c",
        "brand=amber,mode=light": "#f9f5f1",
        "brand=amber,mode=dark": "#2a1f16",
        "brand=opal,mode=light": "#f4f6fc",
        "brand=opal,mode=dark": "#3d4460"
      }
