{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "types": ["react-scripts"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src", "src/react-app-env.d.ts", "src/styles.d.ts"],
  "exclude": ["node_modules"]
}
