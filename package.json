{
  "name": "design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ds/prototypes --",
    "build": "npm run ai && npm run build --workspaces --if-present && node scripts/assemble-site.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"**/*.css\" && npm run tokens:contrast",
    "format": "prettier --write .",
    "test": "vitest run",
    "serve": "npx --yes serve site -l 8096",
    "tokens:contrast": "node packages/tokens/tools/contrast-report.ts --check",
    "ai": "tsx scripts/build-ai.ts && node scripts/agent-pointers.mjs",
    "docs": "npm run dev -w @ds/docs",
    "build:lib": "node scripts/build-lib.mjs",
    "size": "node scripts/build-lib.mjs && node scripts/bundle-size.mjs",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "check:responsive": "node scripts/responsive-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react-docgen-typescript": "^2.4.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
