{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "incremental": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.tsx", "src/**/*.test.ts", "src/**/*.meta.ts", "src/meta.ts"],
  "references": []
}
